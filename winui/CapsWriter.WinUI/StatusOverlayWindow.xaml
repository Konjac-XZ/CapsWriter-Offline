<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CapsWriter_WinUI.StatusOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="OverlayRoot"
        Width="246"
        Height="38"
        Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="202" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="38" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="StatusPane"
            Background="#E614181C"
            BorderThickness="0"
            CornerRadius="19">
            <Grid>
                <Rectangle
                    x:Name="LevelFill"
                    Fill="#2EFFFFFF"
                    RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform
                            x:Name="LevelScaleTransform"
                            ScaleX="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Grid Padding="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StateText"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="正在监听" />
                    <TextBlock
                        x:Name="ElapsedText"
                        Grid.Column="1"
                        MinWidth="62"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="   0.0s"
                        TextAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
        <Button
            x:Name="AbandonButton"
            Grid.Column="2"
            Width="38"
            Height="38"
            Padding="0,0,0,2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#E614181C"
            BorderThickness="0"
            Click="Abandon_Click"
            CornerRadius="19"
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="White"
            ToolTipService.ToolTip="放弃当前任务">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EBD64040" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EEB02A2A" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#BEFFD2D2" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#D2FFE1E1" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            </Button.Resources>
            <TextBlock Foreground="White" Text="×" />
        </Button>
    </Grid>
</Window>
