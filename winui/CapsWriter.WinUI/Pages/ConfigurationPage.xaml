<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CapsWriter_WinUI.Pages.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="14">
            <Grid>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Prompt 与配置" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Reload_Click" Content="重新加载" />
            </Grid>

            <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" />

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="上下文来源" />
                    <Grid ColumnSpacing="20" RowSpacing="8">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="NarrowContextLayout">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ContextColumn1.Width" Value="*" />
                                        <Setter Target="ContextColumn2.Width" Value="0" />
                                        <Setter Target="ContextColumn3.Width" Value="0" />
                                        <Setter Target="ContextColumn4.Width" Value="0" />
                                        <Setter Target="ContextRow1.Height" Value="Auto" />
                                        <Setter Target="ContextRow2.Height" Value="Auto" />
                                        <Setter Target="ContextRow3.Height" Value="Auto" />
                                        <Setter Target="ContextRow4.Height" Value="Auto" />
                                        <Setter Target="HistoryToggle.(Grid.Row)" Value="0" />
                                        <Setter Target="HistoryToggle.(Grid.Column)" Value="0" />
                                        <Setter Target="TextboxToggle.(Grid.Row)" Value="1" />
                                        <Setter Target="TextboxToggle.(Grid.Column)" Value="0" />
                                        <Setter Target="VisionToggle.(Grid.Row)" Value="2" />
                                        <Setter Target="VisionToggle.(Grid.Column)" Value="0" />
                                        <Setter Target="TextboxStateToggle.(Grid.Row)" Value="3" />
                                        <Setter Target="TextboxStateToggle.(Grid.Column)" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MediumContextLayout">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="600" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ContextColumn1.Width" Value="*" />
                                        <Setter Target="ContextColumn2.Width" Value="*" />
                                        <Setter Target="ContextColumn3.Width" Value="0" />
                                        <Setter Target="ContextColumn4.Width" Value="0" />
                                        <Setter Target="ContextRow1.Height" Value="Auto" />
                                        <Setter Target="ContextRow2.Height" Value="Auto" />
                                        <Setter Target="ContextRow3.Height" Value="0" />
                                        <Setter Target="ContextRow4.Height" Value="0" />
                                        <Setter Target="HistoryToggle.(Grid.Row)" Value="0" />
                                        <Setter Target="HistoryToggle.(Grid.Column)" Value="0" />
                                        <Setter Target="TextboxToggle.(Grid.Row)" Value="0" />
                                        <Setter Target="TextboxToggle.(Grid.Column)" Value="1" />
                                        <Setter Target="VisionToggle.(Grid.Row)" Value="1" />
                                        <Setter Target="VisionToggle.(Grid.Column)" Value="0" />
                                        <Setter Target="TextboxStateToggle.(Grid.Row)" Value="1" />
                                        <Setter Target="TextboxStateToggle.(Grid.Column)" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="WideContextLayout">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="820" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ContextColumn1.Width" Value="*" />
                                        <Setter Target="ContextColumn2.Width" Value="*" />
                                        <Setter Target="ContextColumn3.Width" Value="*" />
                                        <Setter Target="ContextColumn4.Width" Value="*" />
                                        <Setter Target="ContextRow1.Height" Value="Auto" />
                                        <Setter Target="ContextRow2.Height" Value="0" />
                                        <Setter Target="ContextRow3.Height" Value="0" />
                                        <Setter Target="ContextRow4.Height" Value="0" />
                                        <Setter Target="HistoryToggle.(Grid.Row)" Value="0" />
                                        <Setter Target="HistoryToggle.(Grid.Column)" Value="0" />
                                        <Setter Target="TextboxToggle.(Grid.Row)" Value="0" />
                                        <Setter Target="TextboxToggle.(Grid.Column)" Value="1" />
                                        <Setter Target="VisionToggle.(Grid.Row)" Value="0" />
                                        <Setter Target="VisionToggle.(Grid.Column)" Value="3" />
                                        <Setter Target="TextboxStateToggle.(Grid.Row)" Value="0" />
                                        <Setter Target="TextboxStateToggle.(Grid.Column)" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ContextColumn1" Width="*" />
                            <ColumnDefinition x:Name="ContextColumn2" Width="*" />
                            <ColumnDefinition x:Name="ContextColumn3" Width="*" />
                            <ColumnDefinition x:Name="ContextColumn4" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ContextRow1" Height="Auto" />
                            <RowDefinition x:Name="ContextRow2" Height="0" />
                            <RowDefinition x:Name="ContextRow3" Height="0" />
                            <RowDefinition x:Name="ContextRow4" Height="0" />
                        </Grid.RowDefinitions>
                        <ToggleSwitch x:Name="HistoryToggle" Header="最近上屏内容" Toggled="ContextToggle_Toggled" OnContent="启用" OffContent="关闭" />
                        <ToggleSwitch x:Name="TextboxToggle" Grid.Column="1" Header="当前文本框" Toggled="ContextToggle_Toggled" OnContent="启用" OffContent="关闭" />
                        <ToggleSwitch x:Name="TextboxStateToggle" Grid.Column="2" Header="活动输入控件状态" Toggled="ContextToggle_Toggled" OnContent="启用" OffContent="关闭" />
                        <ToggleSwitch x:Name="VisionToggle" Grid.Column="3" Header="活动窗口视觉摘要" Toggled="ContextToggle_Toggled" OnContent="启用" OffContent="关闭" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="最近上屏内容" />
                        <Button HorizontalAlignment="Right" Click="ClearHistory_Click" Content="清空" Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="76">
                        <ListView x:Name="PolishHistoryList" MaxHeight="260" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <TextBlock IsTextSelectionEnabled="True" Text="{Binding}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyPolishHistoryText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="暂无内容" />
                    </Grid>
                </Grid>
            </Border>

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AsrPromptTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="ASR Prompt" />
                    <TextBox x:Name="AsrPromptBox" AcceptsReturn="True" MinHeight="150" MaxHeight="320" FontFamily="Cascadia Mono, Consolas" LostFocus="EditableTextBox_LostFocus" TextChanged="AsrPromptBox_TextChanged" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="LLM 润色 Prompt" />
                    <TextBox x:Name="LlmPromptBox" AcceptsReturn="True" MinHeight="220" MaxHeight="520" FontFamily="Cascadia Mono, Consolas" LostFocus="EditableTextBox_LostFocus" TextChanged="LlmPromptBox_TextChanged" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="用户词库" />
                    <TextBox x:Name="LexiconBox" AcceptsReturn="True" MinHeight="220" MaxHeight="520" FontFamily="Cascadia Mono, Consolas" LostFocus="EditableTextBox_LostFocus" TextChanged="LexiconBox_TextChanged" TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
