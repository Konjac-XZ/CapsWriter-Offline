<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CapsWriter_WinUI.Pages.TsfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="TSF-TIP" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="这是面向本机实验性文本服务的运行面板，状态直接来自 Python TSF bridge。" TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel Spacing="5"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Pipe 服务" /><TextBlock x:Name="ServerText" Style="{StaticResource SubtitleTextBlockStyle}" Text="等待状态" /></StackPanel></Border>
                <Border Grid.Column="1" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel Spacing="5"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="TIP 客户端" /><TextBlock x:Name="ClientCountText" Style="{StaticResource SubtitleTextBlockStyle}" Text="0" /></StackPanel></Border>
                <Border Grid.Column="2" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel Spacing="5"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Composition" /><TextBlock x:Name="CompositionStateText" Style="{StaticResource SubtitleTextBlockStyle}" Text="空闲" /></StackPanel></Border>
            </Grid>
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="当前 Composition" />
                    <TextBlock x:Name="CompositionDetailText" Text="当前没有由 TIP 接管的任务。" TextWrapping="Wrap" />
                    <TextBlock x:Name="StartupErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="已连接宿主" />
                    <ItemsControl x:Name="ClientList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
