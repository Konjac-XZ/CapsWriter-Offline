<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CapsWriter_WinUI.Pages.ReflectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="反思循环" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="查看后台个性化学习是否启用、正在等待什么，以及最近一次处理结果。" TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="5"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前阶段" /><TextBlock x:Name="PhaseText" Style="{StaticResource SubtitleTextBlockStyle}" Text="等待状态" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="5"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="待处理修正" /><TextBlock x:Name="PendingText" Style="{StaticResource SubtitleTextBlockStyle}" Text="0" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="5"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已学习偏好" /><TextBlock x:Name="PreferenceText" Style="{StaticResource SubtitleTextBlockStyle}" Text="0" /></StackPanel>
                </Border>
            </Grid>
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="最近一次运行" />
                    <TextBlock x:Name="LatestRunText" Text="还没有反思运行记录。" TextWrapping="Wrap" />
                    <TextBlock x:Name="RuntimeDetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
